{
	# Disable admin API in production
	admin off
	# Disable auto HTTPS since Render terminates SSL at edge reverse proxy
	auto_https off
	# Log in JSON format
	log {
		level WARN
	}
}

:{$PORT:8080} {
	root * /var/www/html/public
	encode zstd gzip

	# Static assets caching for Vite builds
	@static {
		file
		path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Run PHP server with Laravel public routing
	php_server
}
